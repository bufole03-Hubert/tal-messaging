{
  "name": "tal-messaging",
  "version": "1.1.0",
  "private": true,
  "description": "TAL Messaging — assets front (Tailwind CSS, icônes Tabler et polices Inter / Plus Jakarta Sans servies en local)",
  "scripts": {
    "copy:assets": "node scripts/copy-assets.js",
    "build:css": "tailwindcss -c tailwind.config.js -i resources/css/input.css -o public/assets/css/app.css --minify",
    "build": "npm run copy:assets && npm run build:css",
    "watch": "tailwindcss -c tailwind.config.js -i resources/css/input.css -o public/assets/css/app.css --watch",
    "postinstall": "node scripts/copy-assets.js",
    "test:qr": "node tests/qr.test.js"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.0.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.0.0",
    "@tabler/icons-webfont": "^3.0.0",
    "tailwindcss": "^3.4.17"
  }
}
